{
  "name": "donut-rtp-companion",
  "version": "2.2.0",
  "description": "Local screen-only Minecraft coordinate reader and DonutSMP RTP map",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run assets && electron .",
    "start:browser": "node server.cjs",
    "assets": "node scripts/prepare-assets.cjs",
    "test": "node --test test/*.test.cjs",
    "test:browser": "node test/browser.cjs",
    "test:auto": "node test/browser.cjs --desktop",
    "test:electron": "node test/electron.cjs",
    "build:windows": "npm run assets && electron-builder --win --x64 --publish never",
    "build:windows:zip": "npm run assets && electron-builder --win zip --x64 --publish never"
  },
  "keywords": [],
  "author": "Ethan Willingham",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "tesseract.js": "7.0.0"
  }
}
